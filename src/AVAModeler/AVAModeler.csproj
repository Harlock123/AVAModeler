<Project Sdk="Microsoft.NET.Sdk">
  <!-- The application: one window hosting the Modeler and Layout workspaces. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AVAModeler</AssemblyName>
    <RootNamespace>AVAModeler</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <ProjectReference Include="..\AVAModeler.Modeler.UI\AVAModeler.Modeler.UI.csproj" />
    <ProjectReference Include="..\AVAModeler.Layout.UI\AVAModeler.Layout.UI.csproj" />
    <ProjectReference Include="..\AVAModeler.Mcp\AVAModeler.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVAModeler.UI.Tests" />
  </ItemGroup>
</Project>
